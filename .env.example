# --- Jarvis Konfiguration -------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deinen Schluessel ein.
# Die .env wird NICHT von Git erfasst (siehe .gitignore).

# Dein Anthropic API-Key (https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Arbeitsordner der Agents. Relativ zum Projektordner oder absoluter Pfad.
# ALLES, was Jarvis liest oder schreibt, liegt hier drin. Nichts darf hinaus.
JARVIS_WORKSPACE_DIR=workspace

# Modell-ID. Aenderbar ohne Code-Aenderung.
#   claude-opus-5     - staerkstes Modell (Standard)
#   claude-sonnet-5   - guenstiger, fuer einfachere Aufgaben
#   claude-haiku-4-5  - am guenstigsten, fuer sehr einfache Aufgaben
JARVIS_MODEL=claude-opus-5

# Maximale Laenge einer Modellantwort (in Tokens).
JARVIS_MAX_TOKENS=16000

# Sicherheitsbremse: wie viele Denk-/Werkzeug-Runden darf ein Agent maximal
# pro Aufgabe machen, bevor er abbricht?
JARVIS_MAX_STEPS=12

# Groesstes Stueck Datei, das ein Werkzeug am Stueck lesen darf (Bytes).
JARVIS_MAX_READ_BYTES=200000
