# --- Jarvis Konfiguration -------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deine Schluessel ein.
# Die .env wird NICHT von Git erfasst (siehe .gitignore).
#
# PowerShell:  Copy-Item .env.example .env

# --- Modelle --------------------------------------------------------------

# Google Gemini - der zentrale Ansprechpartner hinter Jarvis (ab Etappe 3).
# Kostenlosen Schluessel holen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude - der "Thinktank" fuer schwere Aufgaben (ab Etappe 5).
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Modell-ID fuer den Thinktank. Aenderbar ohne Code-Aenderung.
#   claude-opus-5     - staerkstes Modell (Standard)
#   claude-sonnet-5   - guenstiger, fuer einfachere Aufgaben
#   claude-haiku-4-5  - am guenstigsten, fuer sehr einfache Aufgaben
JARVIS_MODEL=claude-opus-5

# Maximale Laenge einer Modellantwort (in Tokens).
JARVIS_MAX_TOKENS=16000

# --- Workspace ------------------------------------------------------------

# Arbeitsordner der Agents. ALLES, was Jarvis liest oder schreibt, liegt
# hier drin. Nichts darf hinaus.
#
# Immer AUSSERHALB des Projektordners, damit deine Daten nie in einen
# Commit geraten.
#
# Auf diesem Rechner liegt der Workspace auf Laufwerk D:, weil C: fast
# voll ist:
JARVIS_WORKSPACE_DIR=D:\Jarvis-Workspace
#
# Ohne Angabe (Zeile oben auskommentieren): Dokumente\Jarvis-Workspace
#
# Zum Ausprobieren mit den Dummy-Dateien aus dem Repo:
#   JARVIS_WORKSPACE_DIR=test-workspace

# --- Sicherheitsbremsen ---------------------------------------------------

# Wie viele Denk-/Werkzeug-Runden darf ein Agent pro Aufgabe machen?
JARVIS_MAX_STEPS=12

# Groesstes Stueck Datei, das ein Werkzeug am Stueck lesen darf (Bytes).
JARVIS_MAX_READ_BYTES=200000

# --- Server ---------------------------------------------------------------

# Jarvis lauscht nur auf dem eigenen Rechner. Andere Werte als 127.0.0.1,
# localhost oder ::1 werden abgelehnt.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Port der Oberflaeche im Entwicklungsbetrieb (Vite).
JARVIS_UI_DEV_PORT=5173

# Sitzungs-Token: leer lassen! Jarvis wuerfelt bei jedem Start ein neues
# und zeigt dir den fertigen Link an. Nur fuer Sonderfaelle von Hand setzen.
# JARVIS_SESSION_TOKEN=

# --- Kosten ---------------------------------------------------------------

# Gezaehlt wird intern immer in USD (so stehen die Preislisten der Anbieter).
# Dieser Kurs dient nur der Anzeige in EUR.
JARVIS_USD_TO_EUR=0.92

# Limits in USD. Wird eines erreicht, bricht Jarvis ab (ab Etappe 4).
JARVIS_COST_LIMIT_USD_TASK=0.50
JARVIS_COST_LIMIT_USD_DAY=2.00
